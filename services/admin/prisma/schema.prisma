generator client {
  provider = "prisma-client-js"
	output   = "./generated/client"
}

datasource db {
  provider = "postgresql"      
}


model User {
  @@map("admin_users")
  id            String         @id @default(uuid())
  email         String         @unique
  username      String         @unique
  firstname     String         @default("")
  lastname      String         @default("")
  status        Status         @default(active)
  role          Role           @default(USER)
  type          UserType
  avatar        String         @default("")
  isOnline      Boolean        @default(false)
  twoFASecret   String?
  twoFAEnabled  Boolean        @default(false)
  oauthProvider String?
  oauthId       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  jobs          Job[]

  @@unique([oauthProvider, oauthId])
}

model Job {
  @@map("admin_jobs")
  id           String     @id @default(uuid())
  title        String
  description  String
  budget       Float        @default(0)
  category     String
  clientId     String
  status       JobStatus  @default(active)
  createdAt    DateTime   @default(now())
  proposals    Int				@default(0)
  skills       String[]
  deadline     DateTime?
  postedByName String
  createdBy    User       @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
enum Role {
  ADMIN
  USER
  MODERATOR

  @@map("admin_Role")
}

enum Status {
  active
  suspended

  @@map("admin_Status")
}

enum JobStatus {
  active
  flagged
  closed

  @@map("admin_JobStatus")
}

enum UserType {
  FREELANCER
  CLIENT

  @@map("admin_UserType")
}