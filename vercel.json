{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/auth/:match*", "destination": "/api/auth" },
    { "source": "/api/chat/:match*", "destination": "/api/chat" },
    { "source": "/api/friend/:match*", "destination": "/api/chat" },
    { "source": "/api/notifs/:match*", "destination": "/api/chat" },
    { "source": "/api/admin/:match*", "destination": "/api/admin" },
    { "source": "/api/analytics/:match*", "destination": "/api/analytics" },
    { "source": "/api/market/:match*", "destination": "/api/market" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}